# === Приложение ===
APP_NAME=Online Subscription System
ENVIRONMENT=development

# === База данных ===
# Локально (без Docker): укажите свой PostgreSQL
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/subscriptions

# === Безопасность / JWT ===
# Сгенерируйте секрет: openssl rand -hex 32
SECRET_KEY=ЗАМЕНИТЕ_НА_СЛУЧАЙНЫЙ_СЕКРЕТ_64_СИМВОЛА
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# === CORS (для фронтенда) ===
CORS_ORIGINS=*

# === Переменные для docker-compose ===
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=subscriptions
